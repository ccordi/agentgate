# Run `agentgate init` to create .env with demo settings and generated tokens.
# Use this reference to copy individual settings into that file.
# Setup: docs/getting-started.md   Settings: docs/configuration.md
#
# The gateway reads .env from its working directory. Use `agentgate --env-file PATH`
# to select another file for startup or audit commands. Environment variables override
# file values; relative paths use the working directory.
#
# The HTTP tool's MCP server (docs/opencode.md) also reads .env from its working directory.
# Do not commit .env; it is gitignored. Values below are blank or examples.

# Gateway credentials

# Model server key, if required. Replaces the client's credential on local requests.
AGENTGATE_LOCAL_API_KEY=

# Admin API token. Required at startup; generated by `agentgate init`.
# Keep it different from the HTTP tool token and model server key.
AGENTGATE_ADMIN_TOKEN=

# Token used by the HTTP tool to ask the gateway for a policy decision.
# Required at startup; generated by `agentgate init`. Keep it different from the
# admin token and model server key. The MCP server reads it from its environment or .env.
AGENTGATE_PDP_TOKEN=

# Prompt-injection scanner

# Choices: deberta (the classifier), heuristic (the built-in heuristic scanner:
# regular expressions), llm (the LLM judge: a local model, tool results only), combined
# (the classifier and the LLM judge; stricter verdict wins).
# The configured default is deberta; `agentgate init` selects heuristic for the demo.
# The classifier needs the optional `guard` dependencies and local model files,
# built by scripts/convert_piguard_onnx.py into models/piguard-onnx.
# If a configured scanner needs the classifier and it cannot load, the gateway refuses
# to start.
# AGENTGATE_GUARD_BACKEND=deberta

# Directory containing model.onnx, tokenizer.json and any external weight files.
# AGENTGATE_GUARD_MODEL_DIR=/absolute/path/to/piguard-onnx

# Providers and routing

# Provider used when sensitivity routing is off. Default: local.
# Example: select Gemini instead.
# AGENTGATE_DEFAULT_PROVIDER=gemini

# Sensitivity routing and cloud-request redaction are both on by default.
# With routing enabled, these provider settings select the local and cloud routes.
# Both routes default to local; the example below sends the cloud route to Gemini.
# AGENTGATE_ROUTING__ENABLED=true
# AGENTGATE_ROUTING__DEFAULT_LOCAL=local
# AGENTGATE_ROUTING__DEFAULT_CLOUD=gemini
# AGENTGATE_REDACTION_ENABLED=true

# Server, storage and counters (defaults shown)

# Host setup binds to localhost. Docker uses AGENTGATE_CONTAINER_BIND inside the
# container and publishes the port on host localhost.
# AGENTGATE_HOST=127.0.0.1
# AGENTGATE_PORT=4100
# AGENTGATE_DATABASE_URL=sqlite+aiosqlite:///./data/agentgate.db
# AGENTGATE_REDIS_URL=redis://127.0.0.1:6379/0   # falls back to in-process memory if down

# Tracing

# Optional OpenTelemetry (OTLP/HTTP) traces URL, such as http://127.0.0.1:4318/v1/traces;
# requires the optional `tracing` dependencies. Spans
# contain request metadata, not message content. Use a local collector to keep traces
# on this machine.
# AGENTGATE_OTLP_ENDPOINT=

# LLM judge

# The llm and combined scanners use these settings. All three must be set; there is no
# usable default. Unlike a provider's address, the judge URL includes /v1.
# AGENTGATE_JUDGE_API_KEY=
# AGENTGATE_JUDGE_MODEL=<your-local-judge-model>
# AGENTGATE_JUDGE_BASE_URL=http://127.0.0.1:8000/v1

# The LLM judge's verdict cache. Deleting it causes those items to be rescanned.
# AGENTGATE_GUARD_CACHE_PATH=data/guard_cache.json
