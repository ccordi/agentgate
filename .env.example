# Copy this file to `.env` and fill in the values: cp .env.example .env
#
# Loading rules
#   - The gateway (src/agentgate/config.py) reads `.env` via pydantic-settings with
#     prefix `AGENTGATE_` and nested delimiter `__` (e.g. AGENTGATE_ROUTING__ENABLED).
#   - The red-team harness reads the same `.env` with prefixes `AGENTGATE_ATTACKER_`
#     and `AGENTGATE_JUDGE_` (eval/redteam/gen/attacker.py, eval/redteam/judge.py).
#   - Unknown keys are ignored (extra="ignore"), so this one file can hold all groups.
#
# Do not commit `.env`; it is gitignored. This template contains placeholders only.
# [required] means required for the named feature. [optional] has a default.


# Gateway runtime

# [required for the local route] Key for the local OpenAI-compatible upstream (an
# on-device model server). The sensitivity router swaps this in for sensitive content.
# (Merged into providers["local"].api_key — see config.py _apply_local_api_key.)
AGENTGATE_LOCAL_API_KEY=

# [required] Bearer token for `/admin/kill/*`. The gateway will not start without it.
# The token prevents a process with loopback access from clearing the kill switch.
#
# Use a separate value from AGENTGATE_LOCAL_API_KEY. The egress MCP server may receive
# the local upstream key, so reusing it would also grant access to the admin plane.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTGATE_ADMIN_TOKEN=

# [required] Bearer token for the egress PDP (`/a/egress/decision`). The gateway will
# not start without it. Keep it separate from the admin and local-upstream tokens. The
# PEP reads this value from its environment when it calls the PDP.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTGATE_PDP_TOKEN=

# [optional] Injection guard backend, one of: "deberta" (ONNX classifier; needs
# `--extra guard` + a pulled model), "heuristic" (regex fallback), "llm" (local-LLM guard,
# tool output only), "combined" (deberta + llm, worst-case merge). Default: deberta,
# degrading to heuristic when the model is absent ("combined" degrades to "llm").
# AGENTGATE_GUARD_BACKEND=deberta

# [optional] Default upstream provider when routing is off. Default: gemini.
# AGENTGATE_DEFAULT_PROVIDER=gemini

# [optional] Bind + store + counters. Defaults shown.
# HOST must be loopback (127.0.0.1, localhost, or ::1). The proxy routes do not
# authenticate clients, so the gateway rejects non-loopback binds.
# AGENTGATE_HOST=127.0.0.1
# AGENTGATE_PORT=4100
# AGENTGATE_DATABASE_URL=sqlite+aiosqlite:///./data/agentgate.db
# AGENTGATE_REDIS_URL=redis://127.0.0.1:6379/0   # falls back to in-process memory if down

# [optional] Sensitivity-aware routing + cloud-egress redaction. Default: both on.
# AGENTGATE_ROUTING__ENABLED=true
# AGENTGATE_REDACTION_ENABLED=true

# [optional] OpenTelemetry OTLP endpoint (read directly from env in observability/otel.py).
# Needs the `tracing` extra. Each request then emits one metadata-only GenAI span (the audit
# row's fields — never message content). Point it at a local collector to keep telemetry
# on-box, e.g. a self-hosted Langfuse: http://127.0.0.1:3000/api/public/otel
# AGENTGATE_OTLP_ENDPOINT=


# Red-team evaluation (only needed for generation and judging)

# Attacker model (seed-and-mutate generation). Point at a local OpenAI-compatible
# server; use a different model than the gateway's live route.
# AGENTGATE_ATTACKER_API_KEY=
# AGENTGATE_ATTACKER_MODEL=<your-local-attacker-model>
# AGENTGATE_ATTACKER_BASE_URL=http://127.0.0.1:8000/v1

# Judge model (labels captured/generated traffic). The defaults use Gemini. To keep
# corpus text local, configure a local judge instead:
#   AGENTGATE_JUDGE_MODEL=<your-local-judge-model>
#   AGENTGATE_JUDGE_BASE_URL=http://127.0.0.1:8000/v1
# AGENTGATE_JUDGE_API_KEY=
# AGENTGATE_JUDGE_MODEL=gemini-2.5-flash
# AGENTGATE_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Where the LLM guard persists its verdict cache. A cache — safe to delete. The eval
# harness keeps its own (eval/redteam/runs/judge_cache.json) so measurement runs and
# live traffic don't share one artifact.
# AGENTGATE_JUDGE_CACHE_PATH=data/judge_cache.json

# Passive traffic capture (off by default; only the tagged capture agent is captured).
# The default writes inside the repo's data/ dir. For the FP-capture workflow, point it
# at the eval tree — the measured corpus is frozen as
# eval/redteam/corpus/fp_capture.frozen.jsonl and is never appended to in place.
# AGENTGATE_CAPTURE_ENABLED=false
# AGENTGATE_CAPTURE_PATH=data/fp_capture.jsonl
